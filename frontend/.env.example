# Copy to .env.local to change these. Never put secrets here: everything in it ends up in the app.

# Where the backend runs. Leave empty to use port 3000 on the same computer that serves the app
# (works on a phone too, through the Vite "Network" address).
VITE_API_URL=

# true = fake data, no backend needed (same as `npm run dev:mock`)
VITE_USE_MOCKS=
