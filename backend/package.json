    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2"
  }
