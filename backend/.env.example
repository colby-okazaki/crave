# Copy to .env and fill in. Never commit .env.
PORT=3000
DATABASE_URL=
# Pick one restaurant provider
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
# How long a group stays open before it's closed (hours)
GROUP_TTL_HOURS=24
# Front end addresses allowed to call this server (comma-separated). Empty allows any, for local dev.
CORS_ORIGIN=
# Behind a host's proxy: how many proxies sit in front of the server (usually 1), so rate limits see real visitors
TRUST_PROXY=
# Set to off to turn the rate limits off (load test and local testing only)
RATE_LIMIT=
