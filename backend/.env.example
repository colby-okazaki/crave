# Copy to .env and fill in. Never commit .env.
PORT=3000
DATABASE_URL=
# Where restaurants come from: osm (real places from OpenStreetMap, free, no key) or leave empty for fake data
RESTAURANT_SOURCE=
# Optional: your own Nominatim server (the public one allows 1 request a second, so it only suits a small app)
NOMINATIM_URL=
# Optional: Overpass servers to try in order (comma-separated)
OVERPASS_URLS=
# Not used yet; for a paid provider later
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
# How long a group stays open before it's closed (hours)
GROUP_TTL_HOURS=24
# Front end addresses allowed to call this server (comma-separated). Empty allows any, for local dev.
CORS_ORIGIN=
# Behind a host's proxy: how many proxies sit in front of the server (usually 1), so rate limits see real visitors
TRUST_PROXY=
# Set to off to turn the rate limits off (load test and local testing only)
RATE_LIMIT=
