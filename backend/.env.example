# Copy to .env and fill in. Never commit .env.
PORT=3000
DATABASE_URL=
# Where restaurants come from:
#   google: Google Places, with photos, prices and ratings (needs the key below; billed per request)
#   osm:    real places from OpenStreetMap (free, no key, but no photos)
#   empty:  fake data
RESTAURANT_SOURCE=
# Optional: your own Nominatim server (the public one allows 1 request a second, so it only suits a small app)
NOMINATIM_URL=
# Optional: Overpass servers to try in order (comma-separated)
OVERPASS_URLS=
# For RESTAURANT_SOURCE=google. Put it in Render's settings, never in the repo. Restrict it to the Places API.
GOOGLE_PLACES_API_KEY=
# Where phones reach this server, so photo links point back at it (Render sets RENDER_EXTERNAL_URL itself)
PUBLIC_URL=
# Not used yet
YELP_API_KEY=
# How long a group stays open before it's closed (hours)
GROUP_TTL_HOURS=24
# Front end addresses allowed to call this server (comma-separated). Empty allows any, for local dev.
CORS_ORIGIN=
# Behind a host's proxy: how many proxies sit in front of the server (usually 1), so rate limits see real visitors
TRUST_PROXY=
# Set to off to turn the rate limits off (load test and local testing only)
RATE_LIMIT=
